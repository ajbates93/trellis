# ================================
# COHORT APPLICATION ENVIRONMENT
# ================================

# Node Environment
# Options: development, production
NODE_ENV=development

# Application Port (Railway will set this automatically in production)
PORT=3000

# ================================
# DATABASE
# ================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# Local development (with Docker): postgresql://cohort:cohort@localhost:5432/cohort
# Railway production: Railway will inject this automatically
DATABASE_URL=postgresql://user:password@localhost:5432/cohort

# ================================
# AUTHENTICATION (Better-auth)
# ================================

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
#
# For local development:
#   - Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# For production:
#   - Authorized redirect URI: https://your-app.railway.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Better-auth Secret Key
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a different secret in production!
BETTER_AUTH_SECRET=your_secret_key_min_32_chars

# Better-auth Base URL
# This is the public URL of your application
# Local: http://localhost:3000
# Production: https://your-app.railway.app
BETTER_AUTH_URL=http://localhost:3000

# ================================
# OPTIONAL: ERROR TRACKING
# ================================
# Uncomment and configure if using Sentry or similar
# SENTRY_DSN=your_sentry_dsn_here

# ================================
# OPTIONAL: EMAIL (Future Enhancement)
# ================================
# Uncomment when email notifications are implemented
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password
