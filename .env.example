# ================================
# COHORT APPLICATION ENVIRONMENT
# ================================

# Node Environment
# Options: development, production
NODE_ENV=development

# Application Port (Railway will set this automatically in staging/production)
PORT=3000

# ================================
# DATABASE
# ================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# ENVIRONMENT-SPECIFIC VALUES:
#
# Local development:
#   Install PostgreSQL locally (brew install postgresql@16)
#   Create database: createdb cohort
#   DATABASE_URL=postgresql://localhost:5432/cohort
#
# Staging (Railway):
#   Railway will inject this from staging environment
#   DATABASE_URL=[Railway staging database connection string]
#
# Production (Railway):
#   Railway will inject this from production environment
#   DATABASE_URL=[Railway production database connection string]
DATABASE_URL=postgresql://localhost:5432/cohort

# ================================
# AUTHENTICATION (Better-auth)
# ================================

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
#
# IMPORTANT: Configure authorized redirect URIs for each environment:
#
# Local development:
#   - Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#
# Staging (Railway):
#   - Authorized redirect URI: https://your-staging-app.railway.app/api/auth/callback/google
#
# Production (Railway):
#   - Authorized redirect URI: https://your-production-app.railway.app/api/auth/callback/google
#
# NOTE: You can use the same Google OAuth client for all environments,
# or create separate clients for staging/production for better security.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Better-auth Secret Key
# Generate with: openssl rand -base64 32
# IMPORTANT: Use DIFFERENT secrets for each environment!
#
# Local:      openssl rand -base64 32
# Staging:    openssl rand -base64 32  (store in Railway staging env vars)
# Production: openssl rand -base64 32  (store in Railway production env vars)
BETTER_AUTH_SECRET=your_secret_key_min_32_chars

# Better-auth Base URL
# This is the public URL of your application
#
# ENVIRONMENT-SPECIFIC VALUES:
# Local:      http://localhost:3000
# Staging:    https://your-staging-app.railway.app
# Production: https://your-production-app.railway.app
BETTER_AUTH_URL=http://localhost:3000

# ================================
# RATE LIMITING
# ================================
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# The rate limiter derives the client IP from this (F5): with N trusted hops it
# takes the Nth-from-the-end header entry; anything further left is
# client-supplied and ignored.
#
# Local development (direct connection, no proxy): TRUST_PROXY_HOPS=0
# Railway staging/production (one edge proxy):     TRUST_PROXY_HOPS=1 (default)
TRUST_PROXY_HOPS=0

# ================================
# AI INSIGHTS (Anthropic Claude)
# ================================
# API key for Claude 3.5 Haiku (used for feedback sentiment analysis)
# Get your API key from: https://console.anthropic.com/
# Cost: ~$0.001 per analysis
#
# NOTE: Optional for staging, but required for production AI features
# You can use the same API key for all environments.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ================================
# ERROR TRACKING (Sentry)
# ================================
# Sentry DSN for error tracking and performance monitoring
# Get your DSN from: https://sentry.io/ → Settings → Projects → Client Keys (DSN)
#
# IMPORTANT: Use DIFFERENT Sentry projects for each environment!
# This allows you to:
# - Separate staging errors from production errors
# - Set different alert rules per environment
# - Track releases independently
#
# Setup:
# 1. Create separate Sentry projects: trellis-staging, trellis-production
# 2. Get DSN for each project
# 3. Configure environment variables:
#
# Local (optional):     NUXT_PUBLIC_SENTRY_DSN=[your local/dev project DSN]
# Staging (Railway):    NUXT_PUBLIC_SENTRY_DSN=[staging project DSN]
# Production (Railway): NUXT_PUBLIC_SENTRY_DSN=[production project DSN]
#
# Note: NUXT_PUBLIC_ prefix makes this available in client-side runtime config
# The DSN is technically a public key (safe to expose in client code)
NUXT_PUBLIC_SENTRY_DSN=https://your_key@o1234567.ingest.sentry.io/1234567

# ================================
# SLACK INTEGRATION
# ================================
# Slack App credentials for /feedback slash command integration
# Get these from: https://api.slack.com/apps → Your App → Basic Information
#
# Setup Steps:
# 1. Create a new Slack App at https://api.slack.com/apps
# 2. Add Slash Command: /submit (Request URL: {BETTER_AUTH_URL}/api/integrations/slack/commands)
# 3. Enable Interactivity (Request URL: {BETTER_AUTH_URL}/api/integrations/slack/interactions)
# 4. Add OAuth Scopes: commands, users:read, users:read.email, chat:write
# 5. Set OAuth Redirect URL: {BETTER_AUTH_URL}/api/integrations/slack/callback
# 6. Copy credentials below from "Basic Information" → "App Credentials"
#
# ENVIRONMENT-SPECIFIC VALUES:
# All environments can use the same Slack App credentials
# Just update the Request URLs and Redirect URLs in Slack App settings per environment:
#
# Local:      http://localhost:3000/api/integrations/slack/*
# Staging:    https://your-staging-app.railway.app/api/integrations/slack/*
# Production: https://your-production-app.railway.app/api/integrations/slack/*
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ================================
# OPTIONAL: EMAIL (Future Enhancement)
# ================================
# Uncomment when email notifications are implemented
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password

# ================================
# DEMO ENVIRONMENT
# ================================
# Only set these on the demo Railway service.
# Turns the whole app into demo mode: email off, one-click login, reset enabled,
# banner shown, integrations hidden, root redirected to the demo login.
DEMO_MODE=false
# Credentials for the single seeded admin account the demo logs you in as.
DEMO_ADMIN_EMAIL=admin@northwind.demo
DEMO_ADMIN_PASSWORD=change-me-demo-password
# Shared secret required (x-demo-secret header) to trigger POST /api/demo/reset.
DEMO_RESET_SECRET=change-me-reset-secret
