# ================================
# COHORT APPLICATION ENVIRONMENT
# ================================

# Node Environment
# Options: development, production
NODE_ENV=development

# Application Port (Railway will set this automatically in staging/production)
PORT=3000

# ================================
# DATABASE
# ================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# ENVIRONMENT-SPECIFIC VALUES:
#
# Local development:
#   Install PostgreSQL locally (brew install postgresql@16)
#   Create database: createdb cohort
#   DATABASE_URL=postgresql://localhost:5432/cohort
#
# Staging (Railway):
#   Railway will inject this from staging environment
#   DATABASE_URL=[Railway staging database connection string]
#
# Production (Railway):
#   Railway will inject this from production environment
#   DATABASE_URL=[Railway production database connection string]
DATABASE_URL=postgresql://localhost:5432/cohort

# ================================
# AUTHENTICATION (Better-auth)
# ================================

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
#
# IMPORTANT: Configure authorized redirect URIs for each environment:
#
# Local development:
#   - Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#
# Staging (Railway):
#   - Authorized redirect URI: https://your-staging-app.railway.app/api/auth/callback/google
#
# Production (Railway):
#   - Authorized redirect URI: https://your-production-app.railway.app/api/auth/callback/google
#
# NOTE: You can use the same Google OAuth client for all environments,
# or create separate clients for staging/production for better security.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Better-auth Secret Key
# Generate with: openssl rand -base64 32
# IMPORTANT: Use DIFFERENT secrets for each environment!
#
# Local:      openssl rand -base64 32
# Staging:    openssl rand -base64 32  (store in Railway staging env vars)
# Production: openssl rand -base64 32  (store in Railway production env vars)
BETTER_AUTH_SECRET=your_secret_key_min_32_chars

# Better-auth Base URL
# This is the public URL of your application
#
# ENVIRONMENT-SPECIFIC VALUES:
# Local:      http://localhost:3000
# Staging:    https://your-staging-app.railway.app
# Production: https://your-production-app.railway.app
BETTER_AUTH_URL=http://localhost:3000

# ================================
# AI INSIGHTS (Anthropic Claude)
# ================================
# API key for Claude 3.5 Haiku (used for feedback sentiment analysis)
# Get your API key from: https://console.anthropic.com/
# Cost: ~$0.001 per analysis
#
# NOTE: Optional for staging, but required for production AI features
# You can use the same API key for all environments.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ================================
# ERROR TRACKING (Sentry)
# ================================
# Sentry DSN for error tracking and performance monitoring
# Get your DSN from: https://sentry.io/ → Settings → Projects → Client Keys (DSN)
#
# IMPORTANT: Use DIFFERENT Sentry projects for each environment!
# This allows you to:
# - Separate staging errors from production errors
# - Set different alert rules per environment
# - Track releases independently
#
# Setup:
# 1. Create separate Sentry projects: trellis-staging, trellis-production
# 2. Get DSN for each project
# 3. Configure environment variables:
#
# Local (optional):     SENTRY_DSN=[your local/dev project DSN]
# Staging (Railway):    SENTRY_DSN=[staging project DSN]
# Production (Railway): SENTRY_DSN=[production project DSN]
#
# Note: The DSN is technically a public key (safe to expose in client code)
# but using env vars allows easy switching between environments.
SENTRY_DSN=https://your_key@o1234567.ingest.sentry.io/1234567

# ================================
# OPTIONAL: EMAIL (Future Enhancement)
# ================================
# Uncomment when email notifications are implemented
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password
