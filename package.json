    "@nuxt/ui": "^4.0.1",
    "@sentry/nuxt": "^10.32.1",
    "@unovis/vue": "^1.6.1",
    "@vueuse/core": "^13.9.0",
    "better-auth": "^1.3.28",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
